# Security & Performance - Likya Soft
# Path: .htaccess

# 1. Set index.php as the primary Directory Index for Apache
DirectoryIndex index.php index.html

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Block access to database backups, raw logs, and traffic files (CRITICAL SECURITY)
    RewriteRule ^visitor_count\.txt$ - [F,L]
    RewriteRule ^uploads/client_inquiries\.json$ - [F,L]
    RewriteRule ^\.git - [F,L]
    RewriteRule ^\.gitignore$ - [F,L]
    RewriteRule \.(bak|sql|log|ini|sh|inc|swp|dist)$ - [F,L]
</IfModule>

# ----------------------------------------------------------------------
# | Performance Optimizations (Gzip & Caching)                         |
# ----------------------------------------------------------------------

# Gzip Compression (Reduce file size sent to browser)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml
</IfModule>

# Browser Caching (Speed up repeat visits)
<IfModule mod_expires.c>
  ExpiresActive On
  
  # Images (Cache for 1 year)
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  
  # CSS & JS (Cache for 1 month)
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
