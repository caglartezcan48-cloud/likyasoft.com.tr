<?xml version="1.0" encoding="UTF-8"?>
<!-- web.config
     Path: web.config
     Optimized IIS configuration for Likya Soft. Handles Default Documents and Security blocks without hijacking subdirectories. -->
<configuration>
  <system.webServer>
    
    <!-- 1. Force IIS to recognize index.php as the primary Default Document -->
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.php" />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <rewrite>
      <rules>
        <!-- 2. Security Block: Deny access to sensitive files (visitor count, database, logs) -->
        <rule name="Block Sensitive Files" stopProcessing="true">
          <match url="^(visitor_count\.txt|uploads/client_inquiries\.json|\.gitignore|\.git)" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Access is denied." />
        </rule>
      </rules>
    </rewrite>

    <directoryBrowse enabled="false" />
  </system.webServer>
</configuration>
