{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.likyasoft.com.tr/api/:path*"
    },
    {
      "source": "/((?!api/|assets/|public/|uploads/|services/|fethiyemazello/|mazelloerp/|likyapay/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
